1. <?xml version="1.0"?>
<!--
Mining Arena SDF World
======================
50×50m hybrid mining arena with:
- Heightmap terrain (Perlin noise, ±0.15m elevation)
- 70% tunnel corridors (3-4m wide)
- 20% room-and-pillar (8×8m chambers)
- 10% open pit (12° ramps)

Obstacles:
- 40 cylindrical pillars (support columns)
- 15 ore piles (boxes)
- 8 parked equipment (large boxes)
- Perimeter walls

For use with Gazebo Sim (Ignition Gazebo)
-->
<sdf version="1.8">
  <world name="mining_arena">
    
    <!-- Physics settings matching PyBullet -->
    <physics name="default_physics" type="ode">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>100</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>
    
    <!-- Lighting -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 50 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    
    <!-- Ambient light (mine interior is dim) -->
    <light name="ambient" type="point">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.4 0.4 0.35 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>100</range>
        <constant>0.5</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>
    
    <!-- Scene settings -->
    <scene>
      <ambient>0.3 0.3 0.28 1</ambient>
      <background>0.1 0.1 0.1 1</background>
      <shadows>true</shadows>
    </scene>
    
    <!-- ==================== GROUND TERRAIN ==================== -->
    <!-- 
    Heightmap terrain loaded from PNG.
    The heightmap is selected randomly at spawn time via launch parameter.
    Default: terrain_v1.png
    -->
    <model name="terrain">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="terrain_link">
        <collision name="terrain_collision">
          <geometry>
            <heightmap>
              <uri>file://heightmaps/terrain_v1.png</uri>
              <size>50 50 0.3</size>
              <pos>0 0 0</pos>
            </heightmap>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
              </ode>
            </friction>
            <contact>
              <ode>
                <kp>1000000.0</kp>
                <kd>100.0</kd>
              </ode>
            </contact>
          </surface>
        </collision>
        <visual name="terrain_visual">
          <geometry>
            <heightmap>
              <uri>file://heightmaps/terrain_v1.png</uri>
              <size>50 50 0.3</size>
              <pos>0 0 0</pos>
              <texture>
                <diffuse>file://materials/mine_floor.png</diffuse>
                <normal>file://materials/mine_floor_normal.png</normal>
                <size>10</size>
              </texture>
            </heightmap>
          </geometry>
        </visual>
      </link>
    </model>
    
    <!-- ==================== PERIMETER WALLS ==================== -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 25 1 0 0 0</pose>
      <link name="wall_link">
        <collision name="collision">
          <geometry>
            <box><size>50 0.5 2</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>50 0.5 2</size></box>
          </geometry>
          <material>
            <ambient>0.3 0.25 0.2 1</ambient>
            <diffuse>0.4 0.35 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <model name="wall_south">
      <static>true</static>
      <pose>0 -25 1 0 0 0</pose>
      <link name="wall_link">
        <collision name="collision">
          <geometry>
            <box><size>50 0.5 2</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>50 0.5 2</size></box>
          </geometry>
          <material>
            <ambient>0.3 0.25 0.2 1</ambient>
            <diffuse>0.4 0.35 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <model name="wall_east">
      <static>true</static>
      <pose>25 0 1 0 0 0</pose>
      <link name="wall_link">
        <collision name="collision">
          <geometry>
            <box><size>0.5 50 2</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.5 50 2</size></box>
          </geometry>
          <material>
            <ambient>0.3 0.25 0.2 1</ambient>
            <diffuse>0.4 0.35 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <model name="wall_west">
      <static>true</static>
      <pose>-25 0 1 0 0 0</pose>
      <link name="wall_link">
        <collision name="collision">
          <geometry>
            <box><size>0.5 50 2</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.5 50 2</size></box>
          </geometry>
          <material>
            <ambient>0.3 0.25 0.2 1</ambient>
            <diffuse>0.4 0.35 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- ==================== SUPPORT PILLARS (40 total) ==================== -->
    <!-- Pillars arranged in grid pattern for room-and-pillar mining -->
    
    <!-- Row 1 -->
    <model name="pillar_01"><static>true</static><pose>-18 -18 1.5 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><cylinder><radius>0.6</radius><length>3</length></cylinder></geometry></collision>
      <visual name="v"><geometry><cylinder><radius>0.6</radius><length>3</length></cylinder></geometry>
      <material><ambient>0.35 0.3 0.25 1</ambient><diffuse>0.5 0.45 0.4 1</diffuse></material></visual></link></model>
    
    <model name="pillar_02"><static>true</static><pose>-10 -18 1.5 0 0 0</pose>
