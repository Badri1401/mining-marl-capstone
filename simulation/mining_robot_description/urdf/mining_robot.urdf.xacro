<?xml version="1.0"?>
<!--
Mining Robot URDF - Differential Drive with LiDAR and Depth Camera
===================================================================
Robot Specifications:
- Chassis: 200mm diameter × 52mm height, 650g total mass
- Wheels: 65mm diameter × 26mm width, 160mm track width
- Sensors: RPLidar A2 (360°, 10m range), Intel RealSense D435i
- Drive: Differential drive, max 1.5 m/s, max π rad/s

Coordinate Frame Convention:
- X: Forward (robot heading)
- Y: Left
- Z: Up
- Origin: Center of chassis base (ground contact plane)
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mining_robot">

  <!-- ==================== PROPERTIES ==================== -->
  <xacro:property name="chassis_radius" value="0.100"/>
  <xacro:property name="chassis_height" value="0.052"/>
  <xacro:property name="chassis_mass" value="0.50"/>
  
  <xacro:property name="wheel_radius" value="0.0325"/>
  <xacro:property name="wheel_width" value="0.026"/>
  <xacro:property name="wheel_mass" value="0.05"/>
  <xacro:property name="wheel_separation" value="0.160"/>
  
  <xacro:property name="caster_radius" value="0.015"/>
  <xacro:property name="caster_mass" value="0.02"/>
  
  <xacro:property name="lidar_height" value="0.040"/>
  <xacro:property name="lidar_radius" value="0.035"/>
  <xacro:property name="lidar_mass" value="0.10"/>
  
  <xacro:property name="camera_width" value="0.090"/>
  <xacro:property name="camera_depth" value="0.025"/>
  <xacro:property name="camera_height" value="0.025"/>
  <xacro:property name="camera_mass" value="0.08"/>
  
  <!-- Ground clearance -->
  <xacro:property name="ground_clearance" value="0.001"/>
  
  <!-- Friction coefficients -->
  <xacro:property name="wheel_friction" value="0.8"/>
  
  <!-- ==================== MATERIALS ==================== -->
  <material name="chassis_color">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>
  
  <material name="wheel_color">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  
  <material name="sensor_color">
    <color rgba="0.3 0.3 0.8 1.0"/>
  </material>
  
  <material name="camera_color">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>

  <!-- ==================== INERTIA MACROS ==================== -->
  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertia
      ixx="${m*(3*r*r + h*h)/12}" ixy="0" ixz="0"
      iyy="${m*(3*r*r + h*h)/12}" iyz="0"
      izz="${m*r*r/2}"/>
  </xacro:macro>
  
  <xacro:macro name="sphere_inertia" params="m r">
    <inertia
      ixx="${2*m*r*r/5}" ixy="0" ixz="0"
      iyy="${2*m*r*r/5}" iyz="0"
      izz="${2*m*r*r/5}"/>
  </xacro:macro>
  
  <xacro:macro name="box_inertia" params="m x y z">
    <inertia
      ixx="${m*(y*y + z*z)/12}" ixy="0" ixz="0"
      iyy="${m*(x*x + z*z)/12}" iyz="0"
      izz="${m*(x*x + y*y)/12}"/>
  </xacro:macro>

  <!-- ==================== BASE LINK (Chassis) ==================== -->
  <link name="base_footprint"/>
  
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius + ground_clearance}" rpy="0 0 0"/>
  </joint>
  
  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="package://mining_robot_description/meshes/chassis.stl"/>
      </geometry>
      <material name="chassis_color"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${chassis_radius}" length="${chassis_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${chassis_mass}"/>
      <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
      <xacro:cylinder_inertia m="${chassis_mass}" r="${chassis_radius}" h="${chassis_height}"/>
    </inertial>
  </link>

  <!-- ==================== WHEEL MACRO ==================== -->
  <xacro:macro name="wheel" params="prefix y_offset">
    <link name="${prefix}_wheel">
      <visual>
        <geometry>
          <mesh filename="package://mining_robot_description/meshes/wheel.stl"/>
        </geometry>
        <material name="wheel_color"/>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
      </inertial>
    </link>
    
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="0 ${y_offset} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.1" friction="${wheel_friction}"/>
    </joint>
    
    <!-- Gazebo friction settings -->
    <gazebo reference="${prefix}_wheel">
      <mu1>${wheel_friction}</mu1>
      <mu2>${wheel_friction}</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <material>Gazebo/DarkGrey</material>
    </gazebo>
  </xacro:macro>
  
  <!-- Instantiate wheels -->
  <xacro:wheel prefix="left" y_offset="${wheel_separation/2}"/>
  <xacro:wheel prefix="right" y_offset="${-wheel_separation/2}"/>

  <!-- ==================== CASTER WHEEL ==================== -->
  <link name="caster_wheel">
    <visual>
      <geometry>
        <mesh filename="package://mining_robot_description/meshes/caster.stl"/>
      </geometry>
      <material name="wheel_color"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${caster_mass}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <xacro:sphere_inertia m="${caster_mass}" r="${caster_radius}"/>
    </inertial>
  </link>
  
  <joint name="caster_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel"/>
    <!-- Caster at rear of robot, lowered to contact ground -->
    <origin xyz="${-chassis_radius + caster_radius + 0.01} 0 ${-wheel_radius + caster_radius}" rpy="0 0 0"/>
  </joint>
  
  <gazebo reference="caster_wheel">
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <!-- ==================== LIDAR SENSOR ==================== -->
  <link name="lidar_mount">
    <visual>
      <geometry>
        <mesh filename="package://mining_robot_description/meshes/lidar_mount.stl"/>
      </geometry>
      <material name="chassis_color"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.015" length="0.020"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.01"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <xacro:cylinder_inertia m="0.01" r="0.015" h="0.020"/>
    </inertial>
  </link>
  
  <joint name="lidar_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_mount"/>
    <origin xyz="0 0 ${chassis_height + 0.010}" rpy="0 0 0"/>
  </joint>
  
  <link name="lidar_link">
    <visual>
      <geometry>
        <mesh filename="package://mining_robot_description/meshes/lidar_sensor.stl"/>
      </geometry>
      <material name="sensor_color"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${lidar_mass}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <xacro:cylinder_inertia m="${lidar_mass}" r="${lidar_radius}" h="${lidar_height}"/>
    </inertial>
  </link>
  
  <joint name="lidar_joint" type="fixed">
    <parent link="lidar_mount"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 ${lidar_height/2 + 0.010}" rpy="0 0 0"/>
  </joint>
  
  <!-- LiDAR Sensor Frame (optical frame for scan data) -->
  <link name="lidar_optical_frame"/>
  
  <joint name="lidar_optical_joint" type="fixed">
    <parent link="lidar_link"/>
    <child link="lidar_optical_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ==================== DEPTH CAMERA ==================== -->
  <link name="camera_mount">
    <visual>
      <geometry>
        <mesh filename="package://mining_robot_description/meshes/camera_mount.stl"/>
      </geometry>
      <material name="chassis_color"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.040 0.030 0.025"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <xacro:box_inertia m="0.02" x="0.040" y="0.030" z="0.025"/>
    </inertial>
  </link>
  
  <joint name="camera_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_mount"/>
    <!-- Camera mount at front of robot -->
    <origin xyz="${chassis_radius - 0.020} 0 ${chassis_height/2}" rpy="0 0 0"/>
  </joint>
  
  <link name="camera_link">
    <visual>
      <geometry>
        <mesh filename="package://mining_robot_description/meshes/camera_sensor.stl"/>
      </geometry>
      <material name="camera_color"/>
    </visual>
    <collision>
      <geometry>
        <box size="${camera_width} ${camera_depth} ${camera_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${camera_mass}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <xacro:box_inertia m="${camera_mass}" x="${camera_width}" y="${camera_depth}" z="${camera_height}"/>
    </inertial>
  </link>
  
  <joint name="camera_joint" type="fixed">
    <parent link="camera_mount"/>
    <child link="camera_link"/>
    <origin xyz="0.020 0 ${camera_height/2 + 0.0125}" rpy="0 0 0"/>
  </joint>
  
  <!-- Camera Optical Frame (Z forward, X right, Y down per REP-103) -->
  <link name="camera_optical_frame"/>
  
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <!-- Rotate to optical frame convention -->
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>
  
  <!-- Depth Camera Frame -->
  <link name="camera_depth_frame"/>
  
  <joint name="camera_depth_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_depth_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  
  <link name="camera_depth_optical_frame"/>
  
  <joint name="camera_depth_optical_joint" type="fixed">
    <parent link="camera_depth_frame"/>
    <child link="camera_depth_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <!-- ==================== GAZEBO PLUGINS ==================== -->
  
  <!-- Differential Drive Controller -->
  <gazebo>
    <plugin filename="libgazebo_ros_diff_drive.so" name="diff_drive">
      <ros>
        <namespace>/</namespace>
        <remapping>cmd_vel:=cmd_vel</remapping>
        <remapping>odom:=odom</remapping>
      </ros>
      
      <!-- Wheel joints -->
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      
      <!-- Kinematics -->
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_diameter>${wheel_radius * 2}</wheel_diameter>
      
      <!-- Limits -->
      <max_wheel_torque>5.0</max_wheel_torque>
      <max_wheel_acceleration>2.0</max_wheel_acceleration>
      
      <!-- Odometry -->
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      
      <!-- TF -->
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>
      
      <!-- Update rate -->
      <update_rate>100.0</update_rate>
    </plugin>
  </gazebo>
  
  <!-- GPU LiDAR Sensor (RPLidar A2 specs) -->
  <gazebo reference="lidar_link">
    <sensor name="gpu_lidar" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>scan</topic>
      <update_rate>10</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>${-pi}</min_angle>
            <max_angle>${pi}</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.12</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
      <always_on>true</always_on>
      <visualize>true</visualize>
    </sensor>
    <material>Gazebo/Blue</material>
  </gazebo>
  
  <!-- Depth Camera Sensor (Intel RealSense D435i specs) -->
  <gazebo reference="camera_link">
    <sensor name="depth_camera" type="depth_camera">
      <pose>0 0 0 0 0 0</pose>
      <topic>camera/depth</topic>
      <update_rate>30</update_rate>
      <camera>
        <horizontal_fov>${87 * pi / 180}</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R_FLOAT32</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>10.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.005</stddev>
        </noise>
      </camera>
      <always_on>true</always_on>
      <visualize>true</visualize>
    </sensor>
    
    <!-- RGB Camera -->
    <sensor name="rgb_camera" type="camera">
      <pose>0 0 0 0 0 0</pose>
      <topic>camera/image_raw</topic>
      <update_rate>30</update_rate>
      <camera>
        <horizontal_fov>${69 * pi / 180}</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>100.0</far>
        </clip>
      </camera>
      <always_on>true</always_on>
      <visualize>false</visualize>
    </sensor>
    <material>Gazebo/Grey</material>
  </gazebo>
  
  <!-- IMU Sensor (D435i has built-in IMU) -->
  <gazebo reference="camera_link">
    <sensor name="imu_sensor" type="imu">
      <pose>0 0 0 0 0 0</pose>
      <topic>imu</topic>
      <update_rate>200</update_rate>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0002</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0002</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0002</stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.017</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.017</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.017</stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
      <always_on>true</always_on>
    </sensor>
  </gazebo>
  
  <!-- Joint State Publisher -->
  <gazebo>
    <plugin filename="libgazebo_ros_joint_state_publisher.so" name="joint_state_publisher">
      <ros>
        <namespace>/</namespace>
        <remapping>joint_states:=joint_states</remapping>
      </ros>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
      <update_rate>50</update_rate>
    </plugin>
  </gazebo>

</robot>
